# Optional overrides for local development. Copy to `.env` (gitignored).

# API origin. Leave unset in dev to use the Vite proxy (same-origin /api/...).
# VITE_API_BASE_URL=http://localhost:20255

# Row ids the frontend sends for every post (departments are deprecated in
# the UI but the post schema still requires department_id).
# VITE_DEFAULT_DEPARTMENT_ID=1
# VITE_DEFAULT_SCHOOL_ID=1
